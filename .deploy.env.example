# Copy to .deploy.env (git-ignored) and fill in. Read by scripts/deploy.sh.
BUCKET=your-s3-bucket-name
REGION=eu-north-1
DISTRIBUTION_ID=EXXXXXXXXXXXXX
SITE_URL=https://your-domain.com

# Optional: also publish the resume under an older URL so existing links keep working.
# LEGACY_RESUME_KEY="Old Resume Name.pdf"
# Optional: where pre-deploy backups of the live bucket are stored (default: ~/portfolio-s3-backups).
# BACKUP_DIR=
